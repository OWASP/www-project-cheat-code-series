<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.owasp.cheatcode</groupId>
    <artifactId>pathtraversal</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <!-- 17 because Spring 7 requires it; nothing in the PoC itself needs it. -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring.version>7.0.8</spring.version>
    </properties>

    <dependencies>
        <!--
            MultipartFile and MockMultipartFile, for the Spring FalseSanitizer exhibit. The
            version and the Java 17 floor it forces are argued in
            .design_docs/dependency-triage.md - no 6.0.x or 6.1.x release clears all four
            advisories, so those lines are not landing spots.
        -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-test</artifactId>
            <version>${spring.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>4.5.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite</artifactId>
            <version>1.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite-api</artifactId>
            <version>1.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-suite-engine</artifactId>
            <version>1.8.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.owasp.esapi</groupId>
            <artifactId>esapi</artifactId>
            <version>2.7.0.0</version>
            <exclusions>
                <!--
                    EOL with an unfixable advisory, and reached only by ESAPI's access-control
                    policy loader, which this project never calls. Put it back if anything ever
                    calls ESAPI.accessController().
                -->
                <exclusion>
                    <groupId>commons-configuration</groupId>
                    <artifactId>commons-configuration</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!--
            Nothing imports javax.servlet, but ESAPI loads HttpServletRequest at runtime and
            declares it `provided`. Removing this fails all 21 ESAPI cells with NoClassDefFound.
        -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
        </dependency>
        <!--
            Test scope only. Used by the result recorder and the report generator, never by the
            example implementations in src/main - those stay dependency-light on purpose, since
            they are the thing developers are meant to read.
        -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
                <configuration>
                    <!--
                        No testFailureIgnore. A red test now means reality diverged from the
                        declared matrix - either a change moved an implementation, or a payload
                        has never been declared - and that must fail the build. The demonstration
                        that a payload lands is carried by the recorded SECRET_DISCLOSED outcome
                        and the generated report, not by a failing assertion.
                    -->
                    <includes>
                        <include>**/*Test.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
                <executions>
                    <!--
                        mvn exec:java@report - builds the HTML matrix and the README table from
                        the JSON emitted by the last test run. Test scope because the whole
                        reporting harness lives under src/test.
                        Not bound to a lifecycle phase: it must run after `mvn test`, not during it.
                    -->
                    <execution>
                        <id>report</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.owasp.cheatcode.report.ReportGenerator</mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project> 